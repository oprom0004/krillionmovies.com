---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://krillionmovies.com/" }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do you play Krillion Movies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Krillion Movies is a film reverse-trivia game. For each movie prompt (e.g., '1980s Sci-Fi' or 'Best Picture Winner'), you must submit a valid, real movie that the fewest other players will guess. The rarer your answer, the deeper your submarine dives toward the 7,000m Hadal Trench."
      }
    },
    {
      "@type": "Question",
      "name": "What is a 'Crowd Trap' in Krillion Movies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Crowd Trap happens when you guess an obvious, famous blockbuster (like Titanic, Inception, or Pulp Fiction). Because 30% to 50% of players enter those same movies, you get less than 50 meters of depth and get trapped at the ocean surface."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best films to reach 7,000m Hadal Trench?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Early pre-code Oscar winners (Wings, Cavalcade, Grand Hotel), acclaimed European Palme d'Or winners (The Tree of Wooden Clogs, The White Ribbon), and obscure cult sci-fi (Altered States, Phase IV) consistently achieve sub-1% global pick rates, yielding over +980m per round."
      }
    },
    {
      "@type": "Question",
      "name": "Does Krillion Movies reset daily?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! The Daily Movie Dive resets at 00:00 UTC with 7 brand new film prompts for all players globally."
      }
    }
  ]
};
---

<Layout
  title="Krillion Movies | Play Film Reverse-Trivia & Daily Hint Solver"
  description="Play Krillion Movies online for free! Enter rare movie titles to plunge your submarine to 7,000m. Daily clues, prompt solver, and crowd trap cheatsheet."
  schema={{ ...faqSchema }}
>
  <div class="py-4 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
    
    <!-- TOP PLAYABLE GAME VIEWPORT (INSTANT PLAY AT TOP) -->
    <div id="game-arena" class="rounded-3xl bg-[#0a1d36] border border-[#ffd166]/30 p-2 sm:p-3 shadow-2xl overflow-hidden">
      <!-- Game Action Bar -->
      <div class="bg-[#061325] px-4 py-3 rounded-2xl border border-white/10 flex flex-wrap items-center justify-between gap-3 mb-2">
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ffd166] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-[#ffd166]"></span>
          </span>
          <span class="text-white font-black text-sm tracking-wide">KRILLION MOVIES: DAILY ARENA</span>
          <span class="hidden sm:inline-block px-2 py-0.5 rounded-full bg-[#ffd166]/15 border border-[#ffd166]/30 text-[#ffd166] text-[10px] font-mono font-bold uppercase">
            Live Daily Seed
          </span>
        </div>

        <div class="flex items-center gap-2 text-xs font-mono">
          <button
            id="btn-fullscreen-km"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#ffd166] hover:bg-[#ffc83b] text-slate-950 font-bold transition-all shadow-md cursor-pointer"
            title="Play in Fullscreen"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
            </svg>
            <span>FULLSCREEN</span>
          </button>

          <button
            id="btn-reload-km"
            type="button"
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-[#061325] hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-colors cursor-pointer"
            title="Reload Match"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
            </svg>
            <span>Reload</span>
          </button>
        </div>
      </div>

      <!-- Playable Game Frame -->
      <div id="km-frame-wrapper" class="relative w-full rounded-2xl overflow-hidden bg-[#020611] border border-white/5" style="height: clamp(660px, 86vh, 860px);">
        <iframe
          id="km-iframe"
          src="/endless-game/"
          title="Krillion Movies Interactive Arena"
          class="w-full h-full border-0"
          scrolling="no"
          allow="fullscreen; clipboard-write; autoplay"
          loading="eager"
        ></iframe>
      </div>
    </div>

    <!-- DAILY MOVIE SOLVER & RARE ANSWER FINDER (SOLVES USER INTENT) -->
    <div class="p-6 sm:p-8 rounded-3xl bg-[#0a1d36] border border-[#ffd166]/30 shadow-2xl space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-5">
        <div>
          <span class="text-xs font-mono text-[#ffd166] font-bold uppercase tracking-wider">Player Hint & Solver</span>
          <h2 class="text-xl sm:text-2xl font-black text-white mt-1">Stuck on Today's Prompts? Search Winning Rare Answers</h2>
          <p class="text-xs text-[#8fa3c4] mt-1">Check any movie title or category before submitting to avoid crowd traps and guarantee +950m Hadal depth.</p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-[#061325] border border-white/10 text-[#4de3ff]">
          Goal: 7,000m Trench
        </span>
      </div>

      <!-- Quick Search Bar -->
      <div class="space-y-4">
        <div class="relative">
          <input
            id="movie-search-input"
            type="text"
            placeholder="Type any film title or director (e.g. Titanic, Wings, Stalker, Gladiator, The Duellists)..."
            class="w-full bg-[#061325] border border-white/15 focus:border-[#ffd166] rounded-2xl px-5 py-3.5 text-sm text-white placeholder-slate-500 focus:outline-none font-sans shadow-inner"
          />
          <span class="absolute right-4 top-3.5 text-xs text-[#8fa3c4] font-mono">Real-time Analyzer</span>
        </div>

        <!-- Dynamic Result Card -->
        <div id="movie-result-card" class="grid grid-cols-1 md:grid-cols-4 gap-4 p-5 rounded-2xl bg-[#061325] border border-white/10">
          <div class="space-y-1">
            <span class="text-[10px] font-mono text-[#8fa3c4] uppercase">Film / Director</span>
            <div id="res-title" class="text-base font-bold text-white">Wings (1927)</div>
            <div id="res-director" class="text-xs text-[#8fa3c4]">William A. Wellman · 1st Best Picture Winner</div>
          </div>
          <div class="space-y-1 text-center md:border-x md:border-white/10 px-3">
            <span class="text-[10px] font-mono text-[#8fa3c4] uppercase">Est. Global Pick Rate</span>
            <div id="res-rate" class="text-2xl font-black text-[#ffd166] font-mono">1.2%</div>
            <div class="text-[10px] text-slate-400">Extreme Obscurity</div>
          </div>
          <div class="space-y-1 text-center md:border-r md:border-white/10 px-3">
            <span class="text-[10px] font-mono text-[#8fa3c4] uppercase">Depth Yield</span>
            <div id="res-depth" class="text-2xl font-black text-[#ffd166] font-mono">+985m</div>
            <span id="res-badge" class="inline-block text-[10px] font-mono px-2 py-0.5 rounded-full border border-[#ffd166]/40 text-[#ffd166] bg-[#ffd166]/10">
              💎 Hadal Trench
            </span>
          </div>
          <div class="space-y-1 flex flex-col justify-center text-xs text-[#8fa3c4]">
            <span class="text-white font-bold text-[11px] flex items-center gap-1">
              <span class="text-[#ffd166]">💡</span>
              <span>Tactical Verdict:</span>
            </span>
            <p id="res-advice" class="text-[11px] leading-relaxed">
              Masterclass pick! The first ever Best Picture winner. Almost completely forgotten by casual trivia players.
            </p>
          </div>
        </div>

        <!-- Preset Prompt Categories -->
        <div class="space-y-2 pt-2">
          <span class="text-[11px] font-mono text-[#8fa3c4] block uppercase">Quick Cheat Answers by Category:</span>
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <button type="button" class="preset-btn px-3 py-1.5 rounded-xl bg-[#061325] hover:bg-[#0c2444] border border-white/10 text-slate-300 hover:text-white transition cursor-pointer" data-title="Wings (1927)" data-dir="Best Picture (Pre-Code)" data-rate="1.2%" data-depth="+985m" data-zone="Hadal Trench" data-color="text-[#ffd166]" data-advice="God-tier Best Picture answer. Valid Oscar winner that under 2% of players recall.">
              🏆 Best Picture: Wings (1927)
            </button>
            <button type="button" class="preset-btn px-3 py-1.5 rounded-xl bg-[#061325] hover:bg-[#0c2444] border border-white/10 text-slate-300 hover:text-white transition cursor-pointer" data-title="Altered States (1980)" data-dir="1980s Sci-Fi" data-rate="0.9%" data-depth="+990m" data-zone="Hadal Trench" data-color="text-[#ffd166]" data-advice="Far safer than Blade Runner or Terminator. Guarantees near-maximum descent.">
              🚀 1980s Sci-Fi: Altered States
            </button>
            <button type="button" class="preset-btn px-3 py-1.5 rounded-xl bg-[#061325] hover:bg-[#0c2444] border border-white/10 text-slate-300 hover:text-white transition cursor-pointer" data-title="The Duellists (1977)" data-dir="Ridley Scott Film" data-rate="0.7%" data-depth="+993m" data-zone="Hadal Trench" data-color="text-[#ffd166]" data-advice="Ridley Scott's award-winning debut. Bypasses Gladiator and Alien crowd traps completely.">
              🎬 Ridley Scott: The Duellists
            </button>
            <button type="button" class="preset-btn px-3 py-1.5 rounded-xl bg-[#061325] hover:bg-[#0c2444] border border-white/10 text-slate-300 hover:text-white transition cursor-pointer" data-title="The Tree of Wooden Clogs (1978)" data-dir="Palme d'Or Winner" data-rate="0.4%" data-depth="+996m" data-zone="Hadal Trench" data-color="text-[#ffd166]" data-advice="Italian Cannes winner. Obscure yet 100% verified. Instant 996m descent.">
              🌍 Cannes: Wooden Clogs
            </button>
            <button type="button" class="preset-btn px-3 py-1.5 rounded-xl bg-[#061325] hover:bg-[#0c2444] border border-rose-900/40 text-rose-300 hover:text-white transition cursor-pointer" data-title="Titanic (1997)" data-dir="James Cameron" data-rate="52.4%" data-depth="+15m" data-zone="Surface Trap" data-color="text-rose-400" data-advice="FATAL TRAP! Over 50% of players submit this. You will get stuck at 15m depth.">
              ⚠️ Trap: Titanic (1997)
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- The 3 Core Pillar Vaults of Krillion Movies -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/academy-awards/" class="p-6 rounded-3xl bg-[#0a1d36] hover:bg-[#0e2748] border border-white/10 hover:border-[#ffd166]/40 transition space-y-3 group shadow-lg">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-2xl bg-[#061325] border border-white/10 flex items-center justify-center text-[#ffd166] text-xl font-bold group-hover:scale-110 transition-transform">
            🏆
          </div>
          <span class="text-xs font-mono text-[#ffd166] border border-[#ffd166]/30 bg-[#ffd166]/10 px-2.5 py-0.5 rounded-full">
            96 Winners
          </span>
        </div>
        <h3 class="text-xl font-bold text-white group-hover:text-[#ffd166] transition-colors">
          Oscars Best Picture Vault
        </h3>
        <p class="text-xs text-[#8fa3c4] leading-relaxed">
          Full ranking of all 96 Best Picture winners by trivia obscurity. Pre-code classics (Cavalcade, Grand Hotel) give +980m depth.
        </p>
        <div class="text-xs font-mono text-[#ffd166] flex items-center gap-1">
          <span>Browse Oscar Answers</span>
          <span>→</span>
        </div>
      </a>

      <a href="/cult-classics/" class="p-6 rounded-3xl bg-[#0a1d36] hover:bg-[#0e2748] border border-white/10 hover:border-[#4de3ff]/40 transition space-y-3 group shadow-lg">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-2xl bg-[#061325] border border-white/10 flex items-center justify-center text-[#4de3ff] text-xl font-bold group-hover:scale-110 transition-transform">
            📼
          </div>
          <span class="text-xs font-mono text-[#4de3ff] border border-[#4de3ff]/30 bg-[#4de3ff]/10 px-2.5 py-0.5 rounded-full">
            Sub-1% Gems
          </span>
        </div>
        <h3 class="text-xl font-bold text-white group-hover:text-[#4de3ff] transition-colors">
          Cult & Arthouse Deep Cuts
        </h3>
        <p class="text-xs text-[#8fa3c4] leading-relaxed">
          European arthouse gems, Cannes Palme d'Or winners, and midnight sci-fi. Secret answers that guarantee 7,000m Hadal Trench survival.
        </p>
        <div class="text-xs font-mono text-[#4de3ff] flex items-center gap-1">
          <span>Browse Cult Answers</span>
          <span>→</span>
        </div>
      </a>

      <a href="/box-office-bombs/" class="p-6 rounded-3xl bg-[#0a1d36] hover:bg-[#0e2748] border border-white/10 hover:border-[#ffd166]/40 transition space-y-3 group shadow-lg">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-2xl bg-[#061325] border border-white/10 flex items-center justify-center text-[#ffd166] text-xl font-bold group-hover:scale-110 transition-transform">
            💣
          </div>
          <span class="text-xs font-mono text-[#ffd166] border border-[#ffd166]/30 bg-[#ffd166]/10 px-2.5 py-0.5 rounded-full">
            High Budget Flops
          </span>
        </div>
        <h3 class="text-xl font-bold text-white group-hover:text-[#ffd166] transition-colors">
          Box Office Bomb Weapons
        </h3>
        <p class="text-xs text-[#8fa3c4] leading-relaxed">
          Big-budget Hollywood bombs (Cutthroat Island, Heaven's Gate, Ishtar) qualify for blockbuster prompts while staying under 1% pick rates.
        </p>
        <div class="text-xs font-mono text-[#ffd166] flex items-center gap-1">
          <span>Browse Flop Weapons</span>
          <span>→</span>
        </div>
      </a>
    </div>

    <!-- Comparative Table: Surface Trap vs Trench Jewels -->
    <div class="p-6 sm:p-8 rounded-3xl bg-[#0a1d36] border border-white/10 space-y-5">
      <div class="border-b border-white/10 pb-4">
        <h3 class="text-xl font-bold text-white">Daily Prompt Cheatsheet: Traps vs 7,000m Winners</h3>
        <p class="text-xs text-[#8fa3c4] mt-1">See how obvious popular movies kill your depth compared to winning rare alternatives.</p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/10">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-[#061325] text-[#8fa3c4] font-mono uppercase border-b border-white/10">
              <th class="py-3 px-4">Prompt Category</th>
              <th class="py-3 px-4 text-rose-400">⚠️ Fatal Trap (&lt;50m)</th>
              <th class="py-3 px-4 text-[#ffd166]">💎 7,000m Winner (+950m)</th>
              <th class="py-3 px-4">Why It Wins</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 font-sans">
            <tr class="hover:bg-white/5">
              <td class="py-3.5 px-4 font-bold text-white">Best Picture Winner (1990s)</td>
              <td class="py-3.5 px-4 text-slate-300 font-mono"><span class="text-rose-400">Titanic (52%)</span> · +15m</td>
              <td class="py-3.5 px-4 text-[#ffd166] font-mono font-bold">The English Patient (3.8%) · +880m</td>
              <td class="py-3.5 px-4 text-slate-400 text-xs">Crowd always chooses Titanic or Forrest Gump.</td>
            </tr>
            <tr class="hover:bg-white/5">
              <td class="py-3.5 px-4 font-bold text-white">Directed by Ridley Scott</td>
              <td class="py-3.5 px-4 text-slate-300 font-mono"><span class="text-rose-400">Gladiator / Alien (44%)</span> · +40m</td>
              <td class="py-3.5 px-4 text-[#ffd166] font-mono font-bold">The Duellists (1977) (0.9%) · +985m</td>
              <td class="py-3.5 px-4 text-slate-400 text-xs">His acclaimed debut won Cannes Best First Film, unknown to casual gamers.</td>
            </tr>
            <tr class="hover:bg-white/5">
              <td class="py-3.5 px-4 font-bold text-white">A 1980s Sci-Fi Film</td>
              <td class="py-3.5 px-4 text-slate-300 font-mono"><span class="text-rose-400">Blade Runner / Terminator (38%)</span> · +60m</td>
              <td class="py-3.5 px-4 text-[#ffd166] font-mono font-bold">Altered States (1980) (1.2%) · +975m</td>
              <td class="py-3.5 px-4 text-slate-400 text-xs">Ken Russell's body-horror avoids pop culture crowd concentration.</td>
            </tr>
            <tr class="hover:bg-white/5">
              <td class="py-3.5 px-4 font-bold text-white">Cannes Palme d'Or Winner</td>
              <td class="py-3.5 px-4 text-slate-300 font-mono"><span class="text-rose-400">Pulp Fiction / Parasite (41%)</span> · +55m</td>
              <td class="py-3.5 px-4 text-[#ffd166] font-mono font-bold">The Tree of Wooden Clogs (0.4%) · +995m</td>
              <td class="py-3.5 px-4 text-slate-400 text-xs">Ermanno Olmi's 3-hour peasant epic won unanimously but zero pop memory.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="p-6 sm:p-8 rounded-3xl bg-[#0a1d36] border border-white/10 space-y-5">
      <div class="border-b border-white/10 pb-4">
        <h3 class="text-xl font-bold text-white">Frequently Asked Questions</h3>
        <p class="text-xs text-[#8fa3c4] mt-1">Rules and survival tips for Krillion Movies.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="p-4 rounded-2xl bg-[#061325] border border-white/5 space-y-1.5">
          <h4 class="font-bold text-white text-sm">How is depth calculated for movie answers?</h4>
          <p class="text-[#8fa3c4] leading-relaxed text-xs">
            Depth is inversely proportional to crowd submission frequency. Sub-1% obscurity answers yield +950m to +1,000m (Hadal Zone). Answers chosen by over 25% yield under 100m.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-[#061325] border border-white/5 space-y-1.5">
          <h4 class="font-bold text-white text-sm">What happens if I submit an invalid title?</h4>
          <p class="text-[#8fa3c4] leading-relaxed text-xs">
            An invalid movie or typo yields 0 meters for that round. It is better to submit a slightly more common valid movie than risk a 0m penalty.
          </p>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    // Fullscreen and reload handling
    const fsBtn = document.getElementById('btn-fullscreen-km');
    const reloadBtn = document.getElementById('btn-reload-km');
    const iframe = document.getElementById('km-iframe');
    const wrapper = document.getElementById('km-frame-wrapper');

    if (fsBtn && wrapper) {
      fsBtn.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          wrapper.requestFullscreen().catch(err => console.error(err));
        } else {
          document.exitFullscreen();
        }
      });
    }

    if (reloadBtn && iframe) {
      reloadBtn.addEventListener('click', () => {
        const src = iframe.src;
        iframe.src = '';
        setTimeout(() => { iframe.src = src; }, 100);
      });
    }

    // Client-side search analyzer widget
    const input = document.getElementById('movie-search-input');
    const titleEl = document.getElementById('res-title');
    const dirEl = document.getElementById('res-director');
    const rateEl = document.getElementById('res-rate');
    const depthEl = document.getElementById('res-depth');
    const badgeEl = document.getElementById('res-badge');
    const adviceEl = document.getElementById('res-advice');

    const presets = document.querySelectorAll('.preset-btn');
    presets.forEach(btn => {
      btn.addEventListener('click', () => {
        titleEl.textContent = btn.dataset.title;
        dirEl.textContent = btn.dataset.dir;
        rateEl.textContent = btn.dataset.rate;
        depthEl.textContent = btn.dataset.depth;
        badgeEl.textContent = btn.dataset.zone;
        badgeEl.className = `inline-block text-[10px] font-mono px-2 py-0.5 rounded-full border ${
          btn.dataset.zone.includes('Hadal') ? 'border-[#ffd166]/40 text-[#ffd166] bg-[#ffd166]/10' : 'border-rose-800/40 text-rose-300 bg-rose-950/40'
        }`;
        rateEl.className = `text-2xl font-black font-mono ${btn.dataset.color}`;
        adviceEl.textContent = btn.dataset.advice;
        input.value = btn.dataset.title;
      });
    });

    if (input) {
      input.addEventListener('input', (e) => {
        const val = e.target.value.toLowerCase().trim();
        if (!val) return;
        if (val.includes('godfather') || val.includes('titanic') || val.includes('forrest') || val.includes('inception') || val.includes('pulp')) {
          titleEl.textContent = e.target.value;
          dirEl.textContent = 'Mainstream Popular Film';
          rateEl.textContent = '48.9%';
          rateEl.className = 'text-2xl font-black text-rose-400 font-mono';
          depthEl.textContent = '+25m';
          badgeEl.textContent = '⚠️ Surface Crowd Trap';
          badgeEl.className = 'inline-block text-[10px] font-mono px-2 py-0.5 rounded-full border border-rose-800/40 text-rose-300 bg-rose-950/40';
          adviceEl.textContent = 'Lethal mainstream trap! Over 40% of players enter this exact film. You gain almost no depth.';
        } else if (val.includes('wings') || val.includes('cavalcade') || val.includes('stalker') || val.includes('eraserhead') || val.includes('varda') || val.includes('tarkovsky') || val.includes('duellists')) {
          titleEl.textContent = e.target.value;
          dirEl.textContent = 'Verified Rare Deep Cut';
          rateEl.textContent = '0.7%';
          rateEl.className = 'text-2xl font-black text-[#ffd166] font-mono';
          depthEl.textContent = '+985m';
          badgeEl.textContent = '💎 Hadal Trench Zone';
          badgeEl.className = 'inline-block text-[10px] font-mono px-2 py-0.5 rounded-full border border-[#ffd166]/40 text-[#ffd166] bg-[#ffd166]/10';
          adviceEl.textContent = 'Phenomenal choice! Sub-1% frequency guarantees maximum descent into the 7,000m Hadal Trench.';
        } else {
          titleEl.textContent = e.target.value;
          dirEl.textContent = 'Standard Cinema Entry';
          rateEl.textContent = '~5.8%';
