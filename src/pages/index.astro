---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://krillionmovies.com/" }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Krillion Movies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Krillion Movies is a cinema-themed reverse-trivia puzzle game. Instead of guessing the most popular film or famous blockbuster, your goal is to name strictly valid, verifiable movies, directors, or award-winners that have the lowest submission frequency among global players. The rarer your film, the deeper your submarine plunges into the 7,000m Hadal Trench."
      }
    },
    {
      "@type": "Question",
      "name": "What is a 'Crowd Trap' in Krillion Movies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Crowd Trap occurs when a player submits an obvious, mainstream masterpiece (such as Titanic, The Godfather, Inception, or Pulp Fiction). Because over 35% of players choose these exact films, the reverse algorithm penalizes the submission, yielding less than 50 meters of depth and leaving your submarine trapped at the surface."
      }
    },
    {
      "@type": "Question",
      "name": "How is depth calculated for movie answers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Depth yield is inversely proportional to crowd submission frequency. Sub-1% obscurity answers yield +950m to +1,000m (Hadal Zone). Answers chosen by 1% to 5% yield +700m to +900m (Abyssal Zone). Answers chosen by 5% to 15% yield +300m to +600m (Bathyal Zone), while answers above 25% yield under 100m."
      }
    },
    {
      "@type": "Question",
      "name": "Are foreign language and pre-code films valid?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! All theatrically released feature films indexed in verified global cinematic registries (such as AFI, BFI, and IMDb) are valid. Obscure foreign language masterpieces (Cannes Palme d'Or, Venice Golden Lion) and pre-1940 Hollywood films are the most effective strategy to guarantee 990m+ depth."
      }
    }
  ]
};
---

<Layout
  title="Krillion Movies | Play Cinema Reverse Trivia Word Game Online"
  description="Play Krillion Movies online for free. The viral film reverse-trivia game. Name the rarest valid movies, directors, and Oscar winners to plunge your submarine to the 7,000m Hadal Trench."
  schema={{ ...faqSchema }}
>
  <div class="py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-12">
    
    <!-- Hero Intent & Answer-First Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-white/10 pb-8">
      <div class="space-y-3 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0a1d36] border border-[#ffd166]/30 text-[#ffd166] text-xs font-mono font-bold">
          <span>🎬 OFFICIAL CINEMA PACK VAULT</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#4de3ff]"></span>
          <span>DAILY SEED SYNCHRONIZED</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
          Krillion Movies: Cinema Reverse Trivia
        </h1>
        <p class="text-[#8fa3c4] text-xs sm:text-sm leading-relaxed">
          <strong class="text-white">Direct Answer-First Rule:</strong> Krillion Movies completely inverts standard film trivia. When presented with a category prompt (e.g. <em>"A Best Picture winner directed by an immigrant"</em> or <em>"A 1970s Sci-Fi film"</em>), submitting the most famous film is fatal. Your submarine dives deeper only when your answer is valid, verified, and submitted by the <span class="text-[#ffd166] font-semibold">smallest percentage of global players</span>. Obvious blockbusters trigger the Surface Trap; obscure arthouse gems dive you to the 7,000m Hadal Trench.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-[#0a1d36] border border-[#ffd166]/20 text-right min-w-[240px] space-y-1 shadow-lg">
        <span class="text-[11px] font-mono uppercase tracking-wider text-[#8fa3c4]">Hadal Trench Objective</span>
        <div class="text-2xl sm:text-3xl font-black text-[#ffd166] font-mono">7,000m DEPTH</div>
        <div class="text-[11px] font-mono text-[#4de3ff]">Sub-1% Cinephile Obscurity</div>
      </div>
    </div>

    <!-- Playable Game Viewport -->
    <div class="rounded-3xl bg-[#0a1d36] border border-[#ffd166]/30 p-2 shadow-2xl overflow-hidden">
      <div class="bg-[#061325] px-4 py-3 rounded-2xl border border-white/5 flex items-center justify-between mb-2">
        <div class="flex items-center gap-2 text-xs font-mono">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ffd166] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#ffd166]"></span>
          </span>
          <span class="text-white font-bold">LIVE CINEMA ARENA: DAILY SEED ACTIVE</span>
        </div>
        <div class="flex items-center gap-3 text-xs font-mono">
          <a href="/academy-awards/" class="text-[#4de3ff] hover:underline">Oscars Database ↗</a>
          <a href="/cult-classics/" class="text-[#ffd166] hover:underline">Cult Gems ↗</a>
        </div>
      </div>

      <div class="relative w-full aspect-[16/10] sm:aspect-[16/9] min-h-[520px] rounded-2xl overflow-hidden bg-[#020611]">
        <iframe
          src="https://www.krillion.org/play/movies/"
          title="Krillion Movies Interactive Arena"
          class="w-full h-full border-0"
          allow="fullscreen"
          loading="eager"
        ></iframe>
      </div>
    </div>

    <!-- Interactive Cinephile Rarity & Depth Search Engine -->
    <div class="p-6 sm:p-8 rounded-3xl bg-[#0a1d36] border border-[#4de3ff]/20 shadow-2xl space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-5">
        <div>
          <span class="text-[11px] font-mono text-[#ffd166] font-bold uppercase tracking-wider">Cinephile Intelligence Tool</span>
          <h2 class="text-xl sm:text-2xl font-black text-white">Movie Rarity & Submarine Depth Analyzer</h2>
          <p class="text-xs text-[#8fa3c4] mt-1">Search or test common cinema answers to calculate crowd pick rate, depth yield, and avoid deadly traps.</p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-[#061325] border border-white/10 text-[#4de3ff]">
          Database: 2,400+ Verified Films
        </span>
      </div>

      <!-- Quick Search Bar -->
      <div class="space-y-4">
        <div class="relative">
          <input
            id="movie-search-input"
            type="text"
            placeholder="Type a film title or director (e.g. Titanic, Wings, Stalker, Forrest Gump, Eraserhead)..."
            class="w-full bg-[#061325] border border-white/15 focus:border-[#4de3ff] rounded-2xl px-5 py-3.5 text-sm text-white placeholder-slate-500 focus:outline-none font-sans shadow-inner"
          />
          <span class="absolute right-4 top-3.5 text-xs text-[#8fa3c4] font-mono">Real-time Analyzer</span>
        </div>

        <!-- Dynamic Result Card -->
        <div id="movie-result-card" class="grid grid-cols-1 md:grid-cols-4 gap-4 p-5 rounded-2xl bg-[#061325] border border-white/10">
          <div class="space-y-1">
            <span class="text-[10px] font-mono text-[#8fa3c4] uppercase">Analyzed Film</span>
            <div id="res-title" class="text-base font-bold text-white">Titanic (1997)</div>
            <div id="res-director" class="text-xs text-[#8fa3c4]">James Cameron · 11 Oscars</div>
          </div>
          <div class="space-y-1 text-center md:border-x md:border-white/10 px-3">
            <span class="text-[10px] font-mono text-[#8fa3c4] uppercase">Est. Global Pick Rate</span>
            <div id="res-rate" class="text-2xl font-black text-rose-400 font-mono">52.4%</div>
            <div class="text-[10px] text-slate-400">Extreme Crowd Density</div>
          </div>
          <div class="space-y-1 text-center md:border-r md:border-white/10 px-3">
            <span class="text-[10px] font-mono text-[#8fa3c4] uppercase">Depth Yield</span>
            <div id="res-depth" class="text-2xl font-black text-slate-400 font-mono">+15m</div>
            <span id="res-badge" class="inline-block text-[10px] font-mono px-2 py-0.5 rounded-full bg-rose-950/40 text-rose-300 border border-rose-800/40">
              ⚠️ Surface Trap
            </span>
          </div>
          <div class="space-y-1 flex flex-col justify-center text-xs text-[#8fa3c4]">
            <span class="text-white font-bold text-[11px] flex items-center gap-1">
              <span class="text-[#ffd166]">💡</span>
              <span>Tactical Verdict:</span>
            </span>
            <p id="res-advice" class="text-[11px] leading-relaxed">
              Fatal mistake. Over half of all players instinctively submit Titanic for 1990s or Oscar prompts. Yields near-zero depth.
            </p>
          </div>
        </div>

        <!-- Preset Interactive Test Chips -->
        <div class="flex flex-wrap items-center gap-2 pt-1 text-xs">
          <span class="text-[#8fa3c4] font-mono text-[11px]">Test Presets:</span>
          <button type="button" class="preset-btn px-3 py-1 rounded-lg bg-[#061325] hover:bg-[#0c2444] border border-white/10 text-slate-300 hover:text-white transition" data-title="Wings (1927)" data-dir="William A. Wellman" data-rate="1.4%" data-depth="+980m" data-zone="Hadal Trench" data-color="text-[#ffd166]" data-advice="Masterclass pick! The very first Best Picture winner. Almost completely forgotten by casual players.">
            🏆 Wings (1927)
          </button>
          <button type="button" class="preset-btn px-3 py-1 rounded-lg bg-[#061325] hover:bg-[#0c2444] border border-white/10 text-slate-300 hover:text-white transition" data-title="Stalker (1979)" data-dir="Andrei Tarkovsky" data-rate="0.6%" data-depth="+995m" data-zone="Hadal Trench" data-color="text-[#ffd166]" data-advice="God-tier Sci-Fi pick. Sub-1% global frequency guarantees near-maximum descent.">
            📼 Stalker (1979)
          </button>
          <button type="button" class="preset-btn px-3 py-1 rounded-lg bg-[#061325] hover:bg-[#0c2444] border border-white/10 text-slate-300 hover:text-white transition" data-title="Cutthroat Island (1995)" data-dir="Renny Harlin" data-rate="0.3%" data-depth="+998m" data-zone="Hadal Trench" data-color="text-[#ffd166]" data-advice="Legendary $100M box office bomb. Perfect weapon for 90s action or pirate prompts.">
            💣 Cutthroat Island (1995)
          </button>
          <button type="button" class="preset-btn px-3 py-1 rounded-lg bg-[#061325] hover:bg-[#0c2444] border border-white/10 text-slate-300 hover:text-white transition" data-title="Inception (2010)" data-dir="Christopher Nolan" data-rate="48.1%" data-depth="+30m" data-zone="Surface Trap" data-color="text-rose-400" data-advice="Lethal trap. Christopher Nolan blockbusters are universally submitted by casual trivia players.">
            ⚠️ Inception (2010)
          </button>
        </div>
      </div>
    </div>

    <!-- The 4 Core Pillar Categories of Krillion Movies -->
    <div class="space-y-6">
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <div>
          <h2 class="text-2xl font-black text-white">Cinephile Survival Knowledge Banks</h2>
          <p class="text-xs text-[#8fa3c4] mt-1">Explore specialized archives to build an unbeatable mental catalog for every movie prompt.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/academy-awards/" class="p-6 sm:p-7 rounded-3xl bg-[#0a1d36] hover:bg-[#0e2748] border border-white/10 hover:border-[#ffd166]/40 transition-all space-y-4 group shadow-lg">
          <div class="flex items-center justify-between">
            <div class="w-12 h-12 rounded-2xl bg-[#061325] border border-white/10 flex items-center justify-center text-[#ffd166] text-xl font-bold group-hover:scale-110 transition-transform">
              🏆
            </div>
            <span class="text-xs font-mono text-[#ffd166] border border-[#ffd166]/30 bg-[#ffd166]/10 px-2.5 py-0.5 rounded-full">
              96 Winners Indexed
            </span>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-[#ffd166] transition-colors">
            Oscars Best Picture Vault
          </h3>
          <p class="text-xs text-[#8fa3c4] leading-relaxed">
            Full mathematical breakdown of all 96 Best Picture winners. Discover why early pre-code winners (*Cavalcade*, *The Broadway Melody*) yield +980m while 1990s hits (*Forrest Gump*, *Titanic*) yield less than 50m.
          </p>
          <div class="text-xs font-mono text-[#ffd166] flex items-center gap-1">
            <span>Explore Oscar Matrix</span>
            <span>→</span>
          </div>
        </a>

        <a href="/cult-classics/" class="p-6 sm:p-7 rounded-3xl bg-[#0a1d36] hover:bg-[#0e2748] border border-white/10 hover:border-[#4de3ff]/40 transition-all space-y-4 group shadow-lg">
          <div class="flex items-center justify-between">
            <div class="w-12 h-12 rounded-2xl bg-[#061325] border border-white/10 flex items-center justify-center text-[#4de3ff] text-xl font-bold group-hover:scale-110 transition-transform">
              📼
            </div>
            <span class="text-xs font-mono text-[#4de3ff] border border-[#4de3ff]/30 bg-[#4de3ff]/10 px-2.5 py-0.5 rounded-full">
              Sub-1% Arthouse
            </span>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-[#4de3ff] transition-colors">
            Cult, Arthouse & French New Wave
          </h3>
          <p class="text-xs text-[#8fa3c4] leading-relaxed">
            European cinema, Cannes Palme d'Or winners, and midnight horror classics. Learn how films by Agnes Varda, Andrei Tarkovsky, and David Lynch guarantee 7,000m Hadal Trench survival.
          </p>
          <div class="text-xs font-mono text-[#4de3ff] flex items-center gap-1">
            <span>Explore Cult Classics</span>
            <span>→</span>
          </div>
        </a>

        <a href="/box-office-bombs/" class="p-6 sm:p-7 rounded-3xl bg-[#0a1d36] hover:bg-[#0e2748] border border-white/10 hover:border-[#ffd166]/40 transition-all space-y-4 group shadow-lg">
          <div class="flex items-center justify-between">
            <div class="w-12 h-12 rounded-2xl bg-[#061325] border border-white/10 flex items-center justify-center text-[#ffd166] text-xl font-bold group-hover:scale-110 transition-transform">
              💣
            </div>
            <span class="text-xs font-mono text-[#ffd166] border border-[#ffd166]/30 bg-[#ffd166]/10 px-2.5 py-0.5 rounded-full">
              High Budget Flops
            </span>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-[#ffd166] transition-colors">
            Legendary Box Office Bombs
          </h3>
          <p class="text-xs text-[#8fa3c4] leading-relaxed">
            The counter-intuitive trivia secret: massive Hollywood financial catastrophes (*Heaven's Gate*, *John Carter*, *Ishtar*) qualify for blockbuster budget prompts while retaining microscopic submission rates.
          </p>
          <div class="text-xs font-mono text-[#ffd166] flex items-center gap-1">
            <span>Explore Flop Arsenal</span>
            <span>→</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Comparative Table: Surface Trap vs Trench Jewels -->
    <div class="p-6 sm:p-8 rounded-3xl bg-[#0a1d36] border border-white/10 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-4">
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-white">Common Prompt Comparison: Surface Traps vs Hadal Jewels</h3>
          <p class="text-xs text-[#8fa3c4] mt-1">Direct contrast showing how conventional answers destroy your depth.</p>
        </div>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/10">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-[#061325] text-[#8fa3c4] font-mono uppercase border-b border-white/10">
              <th class="py-3 px-4">Prompt Category</th>
              <th class="py-3 px-4 text-rose-400">⚠️ Fatal Crowd Trap (&lt;50m)</th>
              <th class="py-3 px-4 text-[#ffd166]">💎 7,000m Hadal Jewel (+950m)</th>
              <th class="py-3 px-4">Strategy Why</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 font-sans">
            <tr class="hover:bg-white/5">
              <td class="py-3.5 px-4 font-bold text-white">Best Picture Winner (1990s)</td>
              <td class="py-3.5 px-4 text-slate-300 font-mono"><span class="text-rose-400">Titanic (52%)</span> · +15m</td>
              <td class="py-3.5 px-4 text-[#ffd166] font-mono font-bold">The English Patient (3.8%) · +880m</td>
              <td class="py-3.5 px-4 text-slate-400 text-xs">90s crowd automatically submits Titanic, Forrest Gump, or Braveheart.</td>
            </tr>
            <tr class="hover:bg-white/5">
              <td class="py-3.5 px-4 font-bold text-white">A Film Directed by Ridley Scott</td>
              <td class="py-3.5 px-4 text-slate-300 font-mono"><span class="text-rose-400">Gladiator / Alien (44%)</span> · +40m</td>
              <td class="py-3.5 px-4 text-[#ffd166] font-mono font-bold">The Duellists (1977) (0.9%) · +985m</td>
              <td class="py-3.5 px-4 text-slate-400 text-xs">His debut historical drama won Cannes Best First Film, unknown to modern viewers.</td>
            </tr>
            <tr class="hover:bg-white/5">
              <td class="py-3.5 px-4 font-bold text-white">A 1980s Sci-Fi Film</td>
              <td class="py-3.5 px-4 text-slate-300 font-mono"><span class="text-rose-400">Blade Runner / Terminator (38%)</span> · +60m</td>
              <td class="py-3.5 px-4 text-[#ffd166] font-mono font-bold">Altered States (1980) (1.2%) · +975m</td>
              <td class="py-3.5 px-4 text-slate-400 text-xs">Ken Russell's sensory deprivation body-horror masterpiece avoids pop-culture saturation.</td>
            </tr>
            <tr class="hover:bg-white/5">
              <td class="py-3.5 px-4 font-bold text-white">A Cannes Palme d'Or Winner</td>
              <td class="py-3.5 px-4 text-slate-300 font-mono"><span class="text-rose-400">Pulp Fiction / Parasite (41%)</span> · +55m</td>
              <td class="py-3.5 px-4 text-[#ffd166] font-mono font-bold">The Tree of Wooden Clogs (1978) (0.4%) · +995m</td>
              <td class="py-3.5 px-4 text-slate-400 text-xs">Ermanno Olmi's 3-hour peasant epic won unanimous praise but zero pop memory.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Comprehensive FAQ Section -->
    <div class="p-6 sm:p-8 rounded-3xl bg-[#0a1d36] border border-white/10 space-y-6">
      <div class="border-b border-white/10 pb-4">
        <h3 class="text-xl font-bold text-white">Frequently Asked Questions: Krillion Movies Strategy</h3>
        <p class="text-xs text-[#8fa3c4] mt-1">Mastering the reverse-trivia algorithm and trench depth mechanics.</p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm">
        <div class="p-4 rounded-2xl bg-[#061325] border border-white/5 space-y-2">
          <h4 class="font-bold text-white text-sm">How does the submarine trench depth scale work?</h4>
          <p class="text-[#8fa3c4] leading-relaxed">
            Each round in Krillion Movies provides 1,000 potential meters of depth. Depth is inversely scored against real-time global player distributions. If less than 1% of players guessed your film, you gain +950m to +1,000m. If 10% guessed it, you gain approximately +400m. If over 30% guessed it, you gain less than +80m. You need 7 near-perfect rounds to breach the 7,000m Hadal Trench.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-[#061325] border border-white/5 space-y-2">
          <h4 class="font-bold text-white text-sm">What happens if I submit an invalid or misspelled movie?</h4>
          <p class="text-[#8fa3c4] leading-relaxed">
            Invalid entries (titles that do not match the category prompt, unverified amateur films, or typos) trigger a catastrophic Ballast Malfunction: 0 meters gained for the round, and an immediate emergency surfacing warning. It is always better to guess a slightly more common valid film than risk a 0m penalty.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-[#061325] border border-white/5 space-y-2">
          <h4 class="font-bold text-white text-sm">Why do pre-code 1930s Hollywood films score so high?</h4>
          <p class="text-[#8fa3c4] leading-relaxed">
            The vast majority of online players are between 16 and 45 years old. Their instinctive cinematic memories are anchored in the 1980s, 1990s, and 2000s. Titles like <em>Cavalcade (1933)</em>, <em>Grand Hotel (1932)</em>, and <em>The Broadway Melody (1929)</em> are 100% valid Oscar winners that less than 1 in 200 players ever recall.
          </p>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    // Client-side search analyzer widget
    const input = document.getElementById('movie-search-input');
    const titleEl = document.getElementById('res-title');
    const dirEl = document.getElementById('res-director');
    const rateEl = document.getElementById('res-rate');
    const depthEl = document.getElementById('res-depth');
    const badgeEl = document.getElementById('res-badge');
    const adviceEl = document.getElementById('res-advice');

    const presets = document.querySelectorAll('.preset-btn');
    presets.forEach(btn => {
      btn.addEventListener('click', () => {
        titleEl.textContent = btn.dataset.title;
        dirEl.textContent = btn.dataset.dir;
        rateEl.textContent = btn.dataset.rate;
        depthEl.textContent = btn.dataset.depth;
        badgeEl.textContent = btn.dataset.zone;
        badgeEl.className = `inline-block text-[10px] font-mono px-2 py-0.5 rounded-full border ${
          btn.dataset.zone.includes('Hadal') ? 'border-[#ffd166]/40 text-[#ffd166] bg-[#ffd166]/10' : 'border-rose-800/40 text-rose-300 bg-rose-950/40'
        }`;
        rateEl.className = `text-2xl font-black font-mono ${btn.dataset.color}`;
        adviceEl.textContent = btn.dataset.advice;
        input.value = btn.dataset.title;
      });
    });

    if (input) {
      input.addEventListener('input', (e) => {
        const val = e.target.value.toLowerCase().trim();
        if (!val) return;
        if (val.includes('godfather') || val.includes('titanic') || val.includes('forrest') || val.includes('inception') || val.includes('pulp')) {
          titleEl.textContent = e.target.value;
          dirEl.textContent = 'Mainstream Landmark Film';
          rateEl.textContent = '48.9%';
          rateEl.className = 'text-2xl font-black text-rose-400 font-mono';
          depthEl.textContent = '+25m';
          badgeEl.textContent = '⚠️ Surface Crowd Trap';
          badgeEl.className = 'inline-block text-[10px] font-mono px-2 py-0.5 rounded-full border border-rose-800/40 text-rose-300 bg-rose-950/40';
          adviceEl.textContent = 'Lethal mainstream trap! Over 40% of all players enter this exact film. You gain almost no depth.';
        } else if (val.includes('wings') || val.includes('cavalcade') || val.includes('stalker') || val.includes('eraserhead') || val.includes('varda') || val.includes('tarkovsky')) {
          titleEl.textContent = e.target.value;
          dirEl.textContent = 'Verified Cinephile Deep Cut';
          rateEl.textContent = '0.7%';
