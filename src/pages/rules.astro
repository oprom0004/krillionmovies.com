---
import Layout from '../layouts/Layout.astro';

const zones = [
  { name: "Hadal Trench Zone", depth: "6,000m – 7,000m+", frequency: "< 1.5%", yieldPerRound: "+950m – +1,000m", color: "border-[#ffd166] text-[#ffd166] bg-[#ffd166]/10", desc: "The holy grail of reverse trivia. Submissions in this tier are verified cinematic deep cuts known only to ardent film historians." },
  { name: "Abyssal Plain Zone", depth: "4,000m – 6,000m", frequency: "1.5% – 5.0%", yieldPerRound: "+750m – +950m", color: "border-[#4de3ff] text-[#4de3ff] bg-[#4de3ff]/10", desc: "Solid cinephile territory. High-descent velocity that avoids mainstream contamination while safely diving deeper." },
  { name: "Bathypelagic Midnight Zone", depth: "1,000m – 4,000m", frequency: "5.0% – 15.0%", yieldPerRound: "+400m – +750m", color: "border-sky-400 text-sky-300 bg-sky-950/40", desc: "Recognizable classics and well-known indie hits. Descent slows down significantly; at risk of failing 7,000m objective." },
  { name: "Mesopelagic Twilight Zone", depth: "200m – 1,000m", frequency: "15.0% – 30.0%", yieldPerRound: "+100m – +400m", color: "border-amber-400 text-amber-300 bg-amber-950/40", desc: "Danger zone. Major franchise entries, popular Oscar contenders, and streaming chart-toppers." },
  { name: "Epipelagic Surface Trap", depth: "0m – 200m", frequency: "> 30.0%", yieldPerRound: "< +100m (Fatal)", color: "border-rose-500 text-rose-300 bg-rose-950/40", desc: "Lethal crowd traps (Titanic, The Godfather, Inception). Yields almost no descent and guarantees submarine failure." }
];

const breadcrumbs = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://krillionmovies.com/" },
  { "@type": "ListItem", "position": 2, "name": "Rules", "item": "https://krillionmovies.com/rules/" }
];
---

<Layout
  title="Rules & Depth Scoring Mechanics | Krillion Movies"
  description="Learn the official rules, mathematical scoring formulas, and submarine trench mechanics of Krillion Movies cinema reverse-trivia."
  canonical="/rules/"
>
  <div class="py-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-12">
    
    <!-- Header -->
    <div class="space-y-3 border-b border-white/10 pb-6">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#ffd166]">
        <span>📖 OFFICIAL RULEBOOK</span>
        <span>•</span>
        <span>REVERSE CINEMA MATHEMATICS</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white">
        Krillion Movies Scoring Rules & Depth Mechanics
      </h1>
      <p class="text-xs sm:text-sm text-[#8fa3c4] leading-relaxed max-w-3xl">
        Krillion Movies is an intellectual inversion of conventional pub trivia. Success is governed by a rigorous mathematical algorithm that rewards rarity and penalizes crowd consensus. Read the official rules below to calibrate your answers.
      </p>
    </div>

    <!-- The Core Mathematical Formula -->
    <div class="p-6 sm:p-8 rounded-3xl bg-[#0a1d36] border border-[#ffd166]/30 shadow-xl space-y-4">
      <span class="text-xs font-mono text-[#ffd166] uppercase font-bold">Mathematical Principle</span>
      <h2 class="text-xl sm:text-2xl font-bold text-white">The Inverse Rarity Exponential Formula</h2>
      <p class="text-xs sm:text-sm text-[#8fa3c4] leading-relaxed">
        Depth awarded in each round is governed by an inverse decay function of the global submission percentage $p$:
      </p>
      <div class="p-4 rounded-2xl bg-[#061325] border border-white/10 font-mono text-sm sm:text-base text-center text-[#4de3ff]">
        Depth(p) = 1000 &times; e^(-0.085 &times; p)
      </div>
      <p class="text-xs text-[#8fa3c4] leading-relaxed">
        Where p represents the exact proportion of players who entered that same film, and 0.085 is the calibrated dispersion constant. If p = 0.5%, depth awarded is +958m. If p = 45%, depth collapses to +22m.
      </p>
    </div>

    <!-- Oceanic Depth Zones Table -->
    <div class="space-y-4">
      <h2 class="text-xl sm:text-2xl font-bold text-white">Oceanic Depth Zones & Thresholds</h2>
      <div class="space-y-3">
        {zones.map(z => (
          <div class={`p-5 rounded-2xl border ${z.color} bg-[#0a1d36] space-y-2 shadow-md`}>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <h3 class="text-base font-bold text-white">{z.name}</h3>
              <div class="flex items-center gap-3 text-xs font-mono">
                <span class="text-slate-300">Target Depth: <strong class="text-white">{z.depth}</strong></span>
                <span>•</span>
                <span class="text-slate-300">Pick Rate: <strong class="text-[#ffd166]">{z.frequency}</strong></span>
              </div>
            </div>
            <p class="text-xs text-[#8fa3c4] leading-relaxed">{z.desc}</p>
            <div class="text-[11px] font-mono text-[#4de3ff]">
              Typical Yield: <strong class="text-white">{z.yieldPerRound}</strong>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Verification & Penalties -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 sm:p-8 rounded-3xl bg-[#0a1d36] border border-white/10 space-y-3">
        <div class="text-[#4de3ff] font-mono text-xs font-bold uppercase">Verification Standard</div>
        <h3 class="text-lg font-bold text-white">What Films Are Considered Valid?</h3>
        <p class="text-xs text-[#8fa3c4] leading-relaxed">
          Films must be feature-length (&ge; 40 minutes) theatrical or festival releases cataloged in recognized international film registries (IMDb, AFI, BFI, CNC). Short films, student projects, YouTube videos, and TV series episodes are rejected by the referee engine.
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-3xl bg-[#0a1d36] border border-rose-500/30 space-y-3">
        <div class="text-rose-400 font-mono text-xs font-bold uppercase">Penalty Mechanics</div>
        <h3 class="text-lg font-bold text-white">Ballast Malfunction & 0m Penalty</h3>
        <p class="text-xs text-[#8fa3c4] leading-relaxed">
          If you enter an invalid title, a misspelled word that cannot be resolved by fuzzy alias matching, or a film that violates the category prompt (e.g. entering a 1980s film for a 1970s prompt), you receive <strong>0 meters</strong> for that round and trigger an emergency warning.
        </p>
      </div>
    </div>

    <!-- Navigation Footer -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
      <a href="/" class="text-[#ffd166] hover:underline flex items-center gap-1">
        <span>← Back to Krillion Movies Arena</span>
      </a>
      <div class="flex items-center gap-4 text-[#8fa3c4]">
        <a href="/academy-awards/" class="hover:text-white">Oscars Database ↗</a>
        <a href="/cult-classics/" class="hover:text-white">Cult Classics ↗</a>
        <a href="/box-office-bombs/" class="hover:text-white">Box Office Bombs ↗</a>
      </div>
    </div>

  </div>
</Layout>
