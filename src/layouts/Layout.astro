---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  schema?: Record<string, any>;
}

const {
  title = "Krillion Movies | Play Cinema Reverse Trivia Word Game Online",
  description = "Play Krillion Movies online for free. The viral film reverse-trivia game where the rarest, least obvious cinematic answers take you to the 7,000m Hadal trench.",
  canonical = Astro.url.pathname,
  schema
} = Astro.props;

const siteUrl = "https://krillionmovies.com";
const currentUrl = `${siteUrl}${canonical}`;
const gscToken = "701jdLFc3LxsSfGSKw_kYTlBGAmuRev4heZdqAPkxJ4";
const umamiId = "8f33aa13-8cf1-46f2-bb4a-1e9c3e8593b4";

const defaultSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Krillion Movies",
      "description": "Play Krillion Movies reverse trivia game online.",
      "publisher": { "@type": "Organization", "name": "Krillion Movies Guild", "url": siteUrl }
    },
    {
      "@type": "VideoGame",
      "@id": `${siteUrl}/#game`,
      "name": "Krillion Movies",
      "url": siteUrl,
      "description": "Guess obscure films and directors to dive your submarine into the oceanic trench.",
      "genre": ["Reverse Trivia", "Cinema", "Word Game"],
      "gamePlatform": ["Web Browser", "Mobile", "Desktop"]
    }
  ]
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content={gscToken} />
    <link rel="canonical" href={currentUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Krillion Movies" />

    <!-- Umami Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiId}></script>

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
  </head>
  <body class="bg-[#020611] text-slate-100 min-h-screen flex flex-col font-sans selection:bg-[#4de3ff]/30 selection:text-white">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-[#061325]/90 backdrop-blur-md border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-[#0a1d36] border border-[#ffd166]/40 flex items-center justify-center text-[#ffd166] font-mono font-bold text-base group-hover:border-[#ffd166] transition-all">
            🎬
          </div>
          <div class="flex flex-col">
            <span class="text-base font-black tracking-tight text-white flex items-center gap-1.5">
              <span>KRILLION</span>
              <span class="text-[#ffd166]">MOVIES</span>
            </span>
            <span class="text-[9px] font-mono text-[#4de3ff] uppercase tracking-wider">Cinema Reverse Trivia</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-1 text-xs font-mono">
          <a href="/" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-all">Play Cinema</a>
          <a href="/academy-awards/" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-all">Oscars Vault</a>
          <a href="/cult-classics/" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-all">Cult & Indie</a>
          <a href="/box-office-bombs/" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-all">Flops & Bombs</a>
          <a href="/rules/" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-all">Rules</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="https://krillion.si/movies/"
            target="_blank"
            class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-[#0a1d36] border border-white/10 text-xs text-[#8fa3c4] hover:text-white transition-all font-mono"
          >
            <span>Krillion.si Hub</span>
            <span class="text-[#ffd166]">↗</span>
          </a>
          <a
            href="/"
            class="px-4 py-2 rounded-xl bg-[#ffd166] hover:bg-[#ffd166]/90 text-slate-950 font-black text-xs transition-all shadow-md font-mono"
          >
            PLAY NOW
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-[#061325] border-t border-white/10 py-10 px-4 sm:px-6 lg:px-8 mt-16 text-xs text-[#8fa3c4]">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="space-y-3">
          <div class="flex items-center gap-2 text-white font-black">
            <span class="text-[#ffd166]">🎬</span>
            <span>KrillionMovies.com</span>
          </div>
          <p class="text-[11px] leading-relaxed">
            The dedicated cinema edition of Krillion. Test your deep film knowledge across Cannes, Oscars, foreign cinema, and cult filmographies.
          </p>
        </div>

        <div>
          <h4 class="text-white font-mono font-bold text-xs uppercase tracking-wider mb-3">Cinema Guides</h4>
          <ul class="space-y-2 font-mono text-[11px]">
            <li><a href="/" class="hover:text-[#ffd166]">Play Cinema Mode</a></li>
            <li><a href="/academy-awards/" class="hover:text-[#ffd166]">Academy Awards Archive</a></li>
            <li><a href="/cult-classics/" class="hover:text-[#ffd166]">Indie & Cult Films (Hadal)</a></li>
            <li><a href="/box-office-bombs/" class="hover:text-[#ffd166]">Box Office Bombs</a></li>
            <li><a href="/rules/" class="hover:text-[#ffd166]">Cinema Scoring Rules</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-mono font-bold text-xs uppercase tracking-wider mb-3">Krillion Network</h4>
          <ul class="space-y-2 font-mono text-[11px]">
            <li><a href="https://krillion.si" target="_blank" class="hover:text-[#ffd166]">Krillion.si (Main Hub)</a></li>
            <li><a href="https://reversekrillion.com" target="_blank" class="hover:text-[#ffd166]">ReverseKrillion.com</a></li>
            <li><a href="https://krillionhints.com" target="_blank" class="hover:text-[#ffd166]">KrillionHints.com</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-mono font-bold text-xs uppercase tracking-wider mb-3">Cinema Anti-Consensus</h4>
          <p class="text-[11px] leading-relaxed mb-2">
            Never submit Titanic, Avatar, or Pulp Fiction. In Krillion Movies, blockbusters cause immediate decompression.
          </p>
          <span class="text-[10px] text-[#4de3ff] font-mono">Hadal Depth Zone: &lt;1.5% Pick</span>
        </div>
      </div>
      <div class="max-w-7xl mx-auto border-t border-white/5 mt-8 pt-6 flex flex-col sm:flex-row items-center justify-between text-[10px]">
        <span>© 2026-2027 KrillionMovies.com. All rights reserved.</span>
        <span>Independent cinema trivia platform</span>
      </div>
    </footer>
  </body>
</html>
